# Copy to .env (or .env.local) and adjust for your setup.
# Defaults to localhost:8000 if unset, matching `python run.py` in backend/.

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# For a deployed backend, e.g.:
# VITE_API_URL=https://your-backend.example.com
# VITE_WS_URL=wss://your-backend.example.com
